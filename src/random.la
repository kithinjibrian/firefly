// Random numbers for firefly: std.random's generator (xoshiro256**,
// seeded, repeatable), plus `normals` for initialising weight arrays.
// Use `random.seeded(n)` for repeatable runs, `random.from_os()` otherwise.
import glowworm.array;
import std.random as rand;

public struct Rng { inner: rand.Rng }

public fun seeded(seed: u64): Rng = Rng { inner: rand.seeded(seed) };
public fun from_os(): Rng = Rng { inner: rand.from_os() };

impl Rng {
    // Uniform in [0, 1).
    public fun uniform(mut self): f64 = self.inner.uniform();

    // An integer in 0..n.
    public fun below(mut self, n: i64): i64 = self.inner.below(n);

    // A normal value with mean `mean` and deviation `std`.
    public fun normal(mut self, mean: f64, std: f64): f64 = self.inner.normal(mean, std);

    // An index drawn with probability `probs[i]` (which should sum to 1);
    // the last index if rounding leaves the draw past the end.
    public fun pick(mut self, probs: f64[]): i64 {
        let u = self.inner.uniform();
        let mut acc = 0.0;
        for i in 0..probs.len {
            acc += probs[i];
            if u < acc {
                return i;
            }
        }
        probs.len - 1
    }

    // A copy of `xs` in random order.
    public fun shuffle<T>(mut self, xs: T[]): T[] = self.inner.shuffle(xs);

    // An array of `shape` with normal values of deviation `scale`.
    public fun normals(mut self, shape: i64[], scale: f64): array.NdArray<f64> {
        let mut data: f64[] = [];
        for i in 0..array.size(shape) {
            data.push(self.inner.normal(0.0, scale));
        }
        array.from(shape, data)
    }
}
