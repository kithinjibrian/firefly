// Reverse-mode automatic differentiation on a tape (`import firefly.graph;`).
//
// Lugha has no shared references, so instead of tensors that point at each
// other, one `Graph` value holds every tensor: its value, its gradient and
// the op that made it. A tensor is just its index (`i64`) in the graph.
// Methods take `mut self`, so the graph changes in place, never copied.
//
//     let mut g = graph.new();
//     let w = g.param(rng.normals([2, 1], 1.0));   // parameters first
//     g.reset();                                     // each step
//     let x = g.input(xs);
//     let y = g.matmul(x, w);
//     let loss = g.mean(y);
//     g.backward(loss);
//     g.sgd(0.1);
//
// Ops: add, sub, mul (element-wise), matmul, add_row (bias), tanh, relu,
// sigmoid, sum, mean, rows (embedding lookup), cross_entropy (softmax +
// negative log-likelihood), reshape; for transformers transpose, scale,
// mul_row (gain), causal_softmax, layernorm, gelu, cols and concat (heads).
// Optimisers: sgd, adam, adamw.
import glowworm.array;
import glowworm.linalg;
import std.math;

// How a tensor was made, naming the tensors it came from.
enum Op {
    Leaf,
    Add(i64, i64),
    Sub(i64, i64),
    Mul(i64, i64),
    MatMul(i64, i64),
    AddRow(i64, i64),
    Tanh(i64),
    Relu(i64),
    Sigmoid(i64),
    Sum(i64),
    Mean(i64),
    Rows(i64, i64[]),
    CrossEntropy(i64, i64[]),
    Reshape(i64),
    Transpose(i64),
    Scale(i64, f64),
    MulRow(i64, i64),
    CausalSoftmax(i64),
    LayerNorm(i64),
    Gelu(i64),
    Cols(i64, i64),
    Concat(i64, i64),
}

public struct Graph {
    values: array.NdArray<f64>[],
    grads: array.NdArray<f64>[],
    ops: Op[],
    // The first `params` tensors are parameters, which `reset` keeps.
    params: i64,
    // Adam's running averages of each parameter's gradient and squared
    // gradient, and its step count.
    moments: array.NdArray<f64>[],
    squares: array.NdArray<f64>[],
    steps: i64,
}

public fun new(): Graph =
    Graph { values: [], grads: [], ops: [], params: 0, moments: [], squares: [], steps: 0 };

impl Graph {
    // ---- Tensors -------------------------------------------------------

    // A trainable parameter; add every parameter before anything else.
    public fun param(mut self, value: array.NdArray<f64>): i64 {
        if self.values.len != self.params {
            panic("add parameters before any other tensor");
        }
        self.params += 1;
        self.push(value, Op.Leaf)
    }

    // A constant input, such as a batch of data.
    public fun input(mut self, value: array.NdArray<f64>): i64 = self.push(value, Op.Leaf);

    // A tensor's value, and its gradient after `backward`.
    public fun value(self, t: i64): array.NdArray<f64> = self.values[t];
    public fun grad(self, t: i64): array.NdArray<f64> = self.grads[t];

    // Replaces a tensor's value, e.g. to load trained weights; the shape
    // must stay the same.
    public fun set_value(mut self, t: i64, value: array.NdArray<f64>) {
        if value.shape != self.values[t].shape {
            panic("set_value can't change shape {self.values[t].shape} to {value.shape}");
        }
        self.values[t] = value;
    }

    // Drops everything but the parameters and zeroes their gradients:
    // call at the start of every training step.
    public fun reset(mut self) {
        while self.values.len > self.params {
            self.values.pop();
            self.grads.pop();
            self.ops.pop();
        }
        for i in 0..self.params {
            self.grads[i] = array.zeros(self.values[i].shape);
        }
    }

    fun push(mut self, value: array.NdArray<f64>, op: Op): i64 {
        self.grads.push(array.zeros(value.shape));
        self.values.push(value);
        self.ops.push(op);
        self.values.len - 1
    }

    // ---- Operations ----------------------------------------------------

    // Element-wise, on equal shapes.
    public fun add(mut self, a: i64, b: i64): i64 {
        let v = self.values[a] + self.values[b];
        self.push(v, Op.Add(a, b))
    }

    public fun sub(mut self, a: i64, b: i64): i64 {
        let v = self.values[a] - self.values[b];
        self.push(v, Op.Sub(a, b))
    }

    public fun mul(mut self, a: i64, b: i64): i64 {
        let v = self.values[a] * self.values[b];
        self.push(v, Op.Mul(a, b))
    }

    // (m × k) · (k × n).
    public fun matmul(mut self, a: i64, b: i64): i64 {
        let v = linalg.matmul(self.values[a], self.values[b]);
        self.push(v, Op.MatMul(a, b))
    }

    // An (m × n) matrix plus an (n) row added to every row: a layer's bias.
    public fun add_row(mut self, a: i64, row: i64): i64 {
        let (m, r) = (self.values[a], self.values[row]);
        if m.shape.len != 2 || r.shape != [m.shape[1]] {
            panic("add_row needs (m × n) and (n), not {m.shape} and {r.shape}");
        }
        let n = m.shape[1];
        let mut out = m;
        for i in 0..out.data.len {
            out.data[i] += r.data[i % n];
        }
        self.push(out, Op.AddRow(a, row))
    }

    public fun tanh(mut self, a: i64): i64 {
        let v = self.values[a].map(fun(x: f64): f64 = tanh_of(x));
        self.push(v, Op.Tanh(a))
    }

    public fun relu(mut self, a: i64): i64 {
        let v = self.values[a].map(fun(x: f64): f64 = if x > 0.0 { x } else { 0.0 });
        self.push(v, Op.Relu(a))
    }

    public fun sigmoid(mut self, a: i64): i64 {
        let v = self.values[a].map(fun(x: f64): f64 = 1.0 / (1.0 + math.exp(-x)));
        self.push(v, Op.Sigmoid(a))
    }

    // The sum or mean of every element, as a one-element tensor.
    public fun sum(mut self, a: i64): i64 {
        let v = array.from([1], [self.values[a].sum()]);
        self.push(v, Op.Sum(a))
    }

    public fun mean(mut self, a: i64): i64 {
        let v = array.from([1], [self.values[a].mean()]);
        self.push(v, Op.Mean(a))
    }

    // Rows `ids` of a (vocab × dim) table, as an (ids.len × dim) matrix:
    // an embedding lookup, the same as one-hot rows times the table.
    public fun rows(mut self, table: i64, ids: i64[]): i64 {
        let t = self.values[table];
        if t.shape.len != 2 {
            panic("rows needs a 2-D table, not shape {t.shape}");
        }
        let (vocab, dim) = (t.shape[0], t.shape[1]);
        let mut data: f64[] = [];
        for id of ids {
            if id < 0 || id >= vocab {
                panic("row {id} is outside a table of {vocab} rows");
            }
            for c in 0..dim {
                data.push(t.data[id * dim + c]);
            }
        }
        self.push(array.from([ids.len, dim], data), Op.Rows(table, ids))
    }

    // The same elements in another shape (sizes must agree).
    public fun reshape(mut self, a: i64, shape: i64[]): i64 {
        let v = self.values[a].reshape(shape);
        self.push(v, Op.Reshape(a))
    }

    // A 2-D tensor with rows and columns swapped.
    public fun transpose(mut self, a: i64): i64 {
        let v = self.values[a].transpose();
        self.push(v, Op.Transpose(a))
    }

    // Every element times the constant `k`.
    public fun scale(mut self, a: i64, k: f64): i64 {
        let v = self.values[a].scale(k);
        self.push(v, Op.Scale(a, k))
    }

    // An (m × n) matrix times an (n) row, element-wise in every row: a
    // layer's gain, as `add_row` is its bias.
    public fun mul_row(mut self, a: i64, row: i64): i64 {
        let (m, r) = (self.values[a], self.values[row]);
        if m.shape.len != 2 || r.shape != [m.shape[1]] {
            panic("mul_row needs (m × n) and (n), not {m.shape} and {r.shape}");
        }
        let n = m.shape[1];
        let mut out = m;
        for i in 0..out.data.len {
            out.data[i] *= r.data[i % n];
        }
        self.push(out, Op.MulRow(a, row))
    }

    // Softmax along each row of a square (T × T) matrix of attention
    // scores, where row i may only look at columns 0..=i: later positions
    // get probability 0, so a token never sees the future.
    public fun causal_softmax(mut self, a: i64): i64 {
        let s = self.values[a];
        if s.shape.len != 2 || s.shape[0] != s.shape[1] {
            panic("causal_softmax needs a square matrix, not shape {s.shape}");
        }
        let t = s.shape[0];
        let mut out: array.NdArray<f64> = array.zeros(s.shape);
        for i in 0..t {
            let lse = log_sum_exp(s.data, i * t, i + 1);
            for j in 0..i + 1 {
                out.data[i * t + j] = math.exp(s.data[i * t + j] - lse);
            }
        }
        self.push(out, Op.CausalSoftmax(a))
    }

    // Each row shifted to mean 0 and scaled to variance 1 (layer
    // normalisation, without its gain and bias: add those with `mul_row`
    // and `add_row`).
    public fun layernorm(mut self, a: i64): i64 {
        let x = self.values[a];
        let n = x.shape[x.shape.len - 1];
        let mut out = x;
        for row in 0..x.data.len / n {
            let (mean, inv) = row_stats(x.data, row * n, n);
            for j in 0..n {
                out.data[row * n + j] = (x.data[row * n + j] - mean) * inv;
            }
        }
        self.push(out, Op.LayerNorm(a))
    }

    // GELU, the smooth ReLU transformers use (tanh approximation).
    public fun gelu(mut self, a: i64): i64 {
        let v = self.values[a].map(fun(x: f64): f64 = 0.5 * x * (1.0 + tanh_of(gelu_inner(x))));
        self.push(v, Op.Gelu(a))
    }

    // Columns `from..from + n` of a matrix: one attention head's slice.
    public fun cols(mut self, a: i64, from: i64, n: i64): i64 {
        let x = self.values[a];
        let (m, w) = (x.shape[0], x.shape[1]);
        if from < 0 || n <= 0 || from + n > w {
            panic("cols {from}..{from + n} are outside a matrix {w} wide");
        }
        let mut data: f64[] = [];
        for i in 0..m {
            for j in from..from + n {
                data.push(x.data[i * w + j]);
            }
        }
        self.push(array.from([m, n], data), Op.Cols(a, from))
    }

    // Two matrices with the same number of rows, side by side.
    public fun concat(mut self, a: i64, b: i64): i64 {
        let (x, y) = (self.values[a], self.values[b]);
        if x.shape.len != 2 || y.shape.len != 2 || x.shape[0] != y.shape[0] {
            panic("concat needs two matrices with as many rows, not {x.shape} and {y.shape}");
        }
        let (m, wa, wb) = (x.shape[0], x.shape[1], y.shape[1]);
        let mut data: f64[] = [];
        for i in 0..m {
            for j in 0..wa {
                data.push(x.data[i * wa + j]);
            }
            for j in 0..wb {
                data.push(y.data[i * wb + j]);
            }
        }
        self.push(array.from([m, wa + wb], data), Op.Concat(a, b))
    }

    // The mean negative log-likelihood of `targets` under softmax(`logits`)
    // row by row: (n × classes) logits, n target classes. Computed through
    // the log-sum-exp with each row's maximum taken out, so large logits
    // can't overflow.
    public fun cross_entropy(mut self, logits: i64, targets: i64[]): i64 {
        let l = self.values[logits];
        if l.shape.len != 2 || l.shape[0] != targets.len {
            panic("cross_entropy needs (n × classes) logits and n targets, not {l.shape} and {targets.len}");
        }
        let classes = l.shape[1];
        let mut total = 0.0;
        for i in 0..targets.len {
            let row = i * classes;
            let target = targets[i];
            if target < 0 || target >= classes {
                panic("target {target} is outside {classes} classes");
            }
            total += log_sum_exp(l.data, row, classes) - l.data[row + target];
        }
        let v = array.from([1], [total / targets.len as f64]);
        self.push(v, Op.CrossEntropy(logits, targets))
    }

    // ---- Learning ------------------------------------------------------

    // Fills every gradient with d`loss`/d(tensor), `loss` being a
    // one-element tensor. Gradients add up, so `reset` between steps.
    public fun backward(mut self, loss: i64) {
        self.grads[loss] = array.ones(self.values[loss].shape);
        let mut i = loss;
        while i >= 0 {
            self.back(i);
            i -= 1;
        }
    }

    // Moves each parameter against its gradient: `p -= lr * grad`.
    public fun sgd(mut self, lr: f64) {
        for i in 0..self.params {
            let step = self.grads[i].scale(lr);
            self.values[i] = self.values[i] - step;
        }
    }

    // Adam (Kingma and Ba): each parameter moves by its bias-corrected
    // average gradient over the root of its average squared gradient, so
    // every weight gets a step of about `lr` whatever its gradient's scale.
    public fun adam(mut self, lr: f64) {
        self.adamw(lr, 0.0);
    }

    // Adam with decoupled weight decay (AdamW, Loshchilov and Hutter): each
    // step also shrinks every parameter by `lr * decay` of itself, which
    // keeps weights small and curbs overfitting.
    public fun adamw(mut self, lr: f64, decay: f64) {
        let (b1, b2, eps) = (0.9, 0.999, 0.00000001);
        if self.moments.len == 0 {
            for i in 0..self.params {
                self.moments.push(array.zeros(self.values[i].shape));
                self.squares.push(array.zeros(self.values[i].shape));
            }
        }
        self.steps += 1;
        let fix1 = 1.0 - math.pow(b1, self.steps as f64);
        let fix2 = 1.0 - math.pow(b2, self.steps as f64);
        for i in 0..self.params {
            let g = self.grads[i];
            let m = self.moments[i].scale(b1) + g.scale(1.0 - b1);
            let s = self.squares[i].scale(b2) + (g * g).scale(1.0 - b2);
            let mut p = self.values[i];
            for k in 0..p.data.len {
                let step = (m.data[k] / fix1) / (math.sqrt(s.data[k] / fix2) + eps);
                p.data[k] -= lr * (step + decay * p.data[k]);
            }
            self.moments[i] = m;
            self.squares[i] = s;
            self.values[i] = p;
        }
    }

    // Passes tensor `i`'s gradient back to the tensors it came from.
    fun back(mut self, i: i64) {
        let g = self.grads[i];
        match self.ops[i] {
            Leaf => {}
            Add(a, b) => {
                self.accumulate(a, g);
                self.accumulate(b, g);
            }
            Sub(a, b) => {
                self.accumulate(a, g);
                self.accumulate(b, -g);
            }
            Mul(a, b) => {
                let (va, vb) = (self.values[a], self.values[b]);
                self.accumulate(a, g * vb);
                self.accumulate(b, g * va);
            }
            MatMul(a, b) => {
                let (va, vb) = (self.values[a], self.values[b]);
                self.accumulate(a, linalg.matmul(g, vb.transpose()));
                self.accumulate(b, linalg.matmul(va.transpose(), g));
            }
            AddRow(a, row) => {
                self.accumulate(a, g);
                let n = g.shape[1];
                let mut sums: array.NdArray<f64> = array.zeros([n]);
                for k in 0..g.data.len {
                    sums.data[k % n] += g.data[k];
                }
                self.accumulate(row, sums);
            }
            Tanh(a) => {
                let t = self.values[i];
                let one: array.NdArray<f64> = array.ones(t.shape);
                self.accumulate(a, g * (one - t * t));
            }
            Relu(a) => {
                let mask = self.values[a].map(fun(x: f64): f64 = if x > 0.0 { 1.0 } else { 0.0 });
                self.accumulate(a, g * mask);
            }
            Sigmoid(a) => {
                let s = self.values[i];
                let one: array.NdArray<f64> = array.ones(s.shape);
                self.accumulate(a, g * s * (one - s));
            }
            Sum(a) => {
                let shape = self.values[a].shape;
                self.accumulate(a, array.full(shape, g.data[0]));
            }
            Rows(table, ids) => {
                let dim = g.shape[1];
                let mut back: array.NdArray<f64> = array.zeros(self.values[table].shape);
                for k in 0..ids.len {
                    for c in 0..dim {
                        back.data[ids[k] * dim + c] += g.data[k * dim + c];
                    }
                }
                self.accumulate(table, back);
            }
            CrossEntropy(logits, targets) => {
                // d(loss)/d(logit) = (softmax - one-hot) / n, row by row.
                let l = self.values[logits];
                let (n, classes) = (l.shape[0], l.shape[1]);
                let scale = g.data[0] / n as f64;
                let mut back: array.NdArray<f64> = array.zeros(l.shape);
                for i in 0..n {
                    let row = i * classes;
                    let lse = log_sum_exp(l.data, row, classes);
                    for j in 0..classes {
                        back.data[row + j] = math.exp(l.data[row + j] - lse) * scale;
                    }
                    back.data[row + targets[i]] -= scale;
                }
                self.accumulate(logits, back);
            }
            Reshape(a) => {
                let shape = self.values[a].shape;
                self.accumulate(a, g.reshape(shape));
            }
            Transpose(a) => {
                self.accumulate(a, g.transpose());
            }
            Scale(a, k) => {
                self.accumulate(a, g.scale(k));
            }
            MulRow(a, row) => {
                let (m, r) = (self.values[a], self.values[row]);
                let n = r.data.len;
                let mut ga = g;
                let mut gr: array.NdArray<f64> = array.zeros(r.shape);
                for k in 0..g.data.len {
                    ga.data[k] = g.data[k] * r.data[k % n];
                    gr.data[k % n] += g.data[k] * m.data[k];
                }
                self.accumulate(a, ga);
                self.accumulate(row, gr);
            }
            CausalSoftmax(a) => {
                // dx = y * (g - Σ g·y), row by row; masked entries have y = 0.
                let y = self.values[i];
                let t = y.shape[0];
                let mut back: array.NdArray<f64> = array.zeros(y.shape);
                for r in 0..t {
                    let mut dot = 0.0;
                    for c in 0..t {
                        dot += g.data[r * t + c] * y.data[r * t + c];
                    }
                    for c in 0..t {
                        back.data[r * t + c] = y.data[r * t + c] * (g.data[r * t + c] - dot);
                    }
                }
                self.accumulate(a, back);
            }
            LayerNorm(a) => {
                // dx = (g - mean(g) - x̂ · mean(g · x̂)) / σ, row by row.
                let x = self.values[a];
                let xhat = self.values[i];
                let n = x.shape[x.shape.len - 1];
                let mut back = g;
                for row in 0..x.data.len / n {
                    let (_, inv) = row_stats(x.data, row * n, n);
                    let mut mean_g = 0.0;
                    let mut mean_gx = 0.0;
                    for j in 0..n {
                        mean_g += g.data[row * n + j];
                        mean_gx += g.data[row * n + j] * xhat.data[row * n + j];
                    }
                    mean_g /= n as f64;
                    mean_gx /= n as f64;
                    for j in 0..n {
                        let k = row * n + j;
                        back.data[k] = (g.data[k] - mean_g - xhat.data[k] * mean_gx) * inv;
                    }
                }
                self.accumulate(a, back);
            }
            Gelu(a) => {
                let x = self.values[a];
                let mut back = g;
                for k in 0..x.data.len {
                    back.data[k] = g.data[k] * gelu_slope(x.data[k]);
                }
                self.accumulate(a, back);
            }
            Cols(a, from) => {
                let x = self.values[a];
                let (m, w, n) = (x.shape[0], x.shape[1], g.shape[1]);
                let mut back: array.NdArray<f64> = array.zeros(x.shape);
                for r in 0..m {
                    for j in 0..n {
                        back.data[r * w + from + j] = g.data[r * n + j];
                    }
                }
                self.accumulate(a, back);
            }
            Concat(a, b) => {
                let (wa, wb) = (self.values[a].shape[1], self.values[b].shape[1]);
                let m = g.shape[0];
                let mut ga: f64[] = [];
                let mut gb: f64[] = [];
                for r in 0..m {
                    for j in 0..wa {
                        ga.push(g.data[r * (wa + wb) + j]);
                    }
                    for j in 0..wb {
                        gb.push(g.data[r * (wa + wb) + wa + j]);
                    }
                }
                self.accumulate(a, array.from([m, wa], ga));
                self.accumulate(b, array.from([m, wb], gb));
            }
            Mean(a) => {
                let shape = self.values[a].shape;
                let n = array.size(shape) as f64;
                self.accumulate(a, array.full(shape, g.data[0] / n));
            }
        }
    }

    fun accumulate(mut self, t: i64, g: array.NdArray<f64>) {
        let sum = self.grads[t] + g;
        self.grads[t] = sum;
    }
}

// log(Σ exp(xs[from..from + n])), with the largest taken out first so no
// `exp` overflows.
fun log_sum_exp(xs: f64[], from: i64, n: i64): f64 {
    let mut top = xs[from];
    for j in 1..n {
        top = math.max(top, xs[from + j]);
    }
    let mut sum = 0.0;
    for j in 0..n {
        sum += math.exp(xs[from + j] - top);
    }
    top + math.ln(sum)
}

// A row's mean and 1 / (standard deviation), with a small epsilon so a
// constant row doesn't divide by zero.
fun row_stats(xs: f64[], from: i64, n: i64): (f64, f64) {
    let mut mean = 0.0;
    for j in 0..n {
        mean += xs[from + j];
    }
    mean /= n as f64;
    let mut var = 0.0;
    for j in 0..n {
        let d = xs[from + j] - mean;
        var += d * d;
    }
    var /= n as f64;
    (mean, 1.0 / math.sqrt(var + 0.00001))
}

// tanh, saturating to ±1 where exp would overflow.
fun tanh_of(x: f64): f64 {
    if x > 20.0 {
        return 1.0;
    }
    if x < -20.0 {
        return -1.0;
    }
    let e = math.exp(2.0 * x);
    (e - 1.0) / (e + 1.0)
}

// GELU's tanh argument: √(2/π) · (x + 0.044715 x³).
fun gelu_inner(x: f64): f64 = 0.7978845608028654 * (x + 0.044715 * x * x * x);

// d/dx of 0.5 · x · (1 + tanh(u(x))).
fun gelu_slope(x: f64): f64 {
    let t = tanh_of(gelu_inner(x));
    let du = 0.7978845608028654 * (1.0 + 3.0 * 0.044715 * x * x);
    0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * du
}
